__pycache__/
*.pyc
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
dist/
build/
informe-*.html

# lista local de palabras sensibles del hook de pre-commit, nunca se versiona
.mufa-sensitive

# secretos de mufa: nunca se versionan
*.pem
*.key
licencia.txt
*.db

# app web compilada (se genera con: cd web && npm run build)
src/mufa/web/
web/node_modules/

# sitio: secretos locales y estado de wrangler
sitio/.dev.vars
sitio/.wrangler/

# Notas internas (plan de lanzamiento, metas): no se publican
notas-privadas/

# Caché local de wrangler (Cloudflare): tiene datos de la cuenta
.wrangler/

# caché de TypeScript (la crea npm run build)
*.tsbuildinfo

# Módulos Pro cifrados: solo van en el repositorio público (scripts/cifrar_pro.py)
src/mufa/pro/modulos.cifrado
