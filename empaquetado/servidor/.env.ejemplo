# Dirección con la que entran a mufa: la IP del servidor o un dominio.
# Con un dominio público que apunte a este servidor, Caddy saca solo el
# certificado de Let's Encrypt. Con una IP usa un certificado propio (el
# navegador avisa la primera vez). instalar.sh la pregunta y la pone acá.
MUFA_DOMINIO=localhost

# Cada cuánto se consulta a los equipos por SNMP (0 = nunca).
MUFA_SONDEO_MINUTOS=5
# Respaldos automáticos: 0 los apaga. La hora del día se elige en la app (Respaldos).
MUFA_RESPALDO_HORAS=24

# Tu zona horaria, para que «las 12:00» sean las 12:00 de tu país.
# Ejemplos: America/Guatemala, America/Mexico_City, America/Bogota, Europe/Madrid
TZ=America/Guatemala
